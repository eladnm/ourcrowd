{
  "name": "ourcrowd-press-monitor",
  "version": "1.0.0",
  "private": true,
  "description": "Press coverage monitoring for OurCrowd portfolio and fund companies",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "collect": "pnpm --filter @ourcrowd/api collect",
    "classify": "pnpm --filter @ourcrowd/api classify",
    "pipeline": "pnpm --filter @ourcrowd/api pipeline",
    "alert": "pnpm --filter @ourcrowd/api alert",
    "export": "pnpm --filter @ourcrowd/api export",
    "api": "pnpm --filter @ourcrowd/api dev",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\" --ignore-path .gitignore",
    "verify:data": "node scripts/verify-export.mjs"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "tsx": "^4.20.0",
    "turbo": "^2.9.6",
    "typescript": "^5.9.3"
  }
}
