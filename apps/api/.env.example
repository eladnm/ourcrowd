# All values below are optional — the defaults work out of the box.

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Per-request timeout for a single classification (ms). Requests queue inside
# Ollama when concurrency > 1, so this needs headroom well above single-request
# latency (~12s for llama3.1:8b on CPU).
OLLAMA_TIMEOUT_MS=180000

# Collection
# How far back to search on a full run. The dashboard shows 90 days.
COLLECTION_WINDOW_DAYS=90
# Polite delay between feed requests (ms). Lower = faster, more throttling risk.
FETCH_DELAY_MS=1200
# Max concurrent classification requests to Ollama. Ollama serves from a single
# loaded model, so raising this past ~2 mostly queues requests rather than
# adding throughput.
CLASSIFY_CONCURRENCY=2

# Storage
DATABASE_PATH=./data/press.db

# API server
PORT=4000

# Daily alert delivery: console | webhook | both
ALERT_CHANNEL=console
# Required when ALERT_CHANNEL includes webhook (Slack-compatible JSON payload).
ALERT_WEBHOOK_URL=
